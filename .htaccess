<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Keamanan: Blokir akses publik ke berkas dan folder sensitif
    RewriteRule ^(\.env|\.git|composer\.|package\.|storage\/|vendor\/) - [F,L]

    # 2. Arahkan seluruh lalu lintas web secara internal ke folder public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>
